# Leave EMPTY for normal development and for a same-origin deployment.
#
# Empty means the app calls /api/... on its own origin, and Vite's `/api` proxy
# (vite.config.ts) forwards to the backend on 8004. That keeps the session
# cookie first-party and avoids CORS entirely.
#
# Set this ONLY when the API lives on a different origin. You must then also add
# this app's origin to CORS_ALLOWED_ORIGINS in src/.env and keep
# allow_credentials on, or the session cookie will be dropped.
VITE_API_BASE_URL=

# Where the Vite dev/preview proxy forwards /api. Defaults to
# http://127.0.0.1:8004 - set this only if you run uvicorn on another port.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8004
